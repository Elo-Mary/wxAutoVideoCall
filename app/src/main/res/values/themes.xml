<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WxAutoVideoCall" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!--
      主页用透明主题：点图标后只弹一个圆角小卡片，
      点卡片外部即退出（见 MainActivity 的 setFinishOnTouchOutside）。
    -->
    <style name="Theme.WxAutoVideoCall.Transparent" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- 老人用的大字按钮：最小高度 96dp，避免误触和看不清。 -->
    <style name="BigActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">96dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
