<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页里的一行联系人：可改名、可设为默认、可删除。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_contact_row"
    android:orientation="vertical"
    android:padding="10dp">

    <EditText
        android:id="@+id/input_row_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_contact_name"
        android:importantForAutofill="no"
        android:inputType="textPersonName"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_row_default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_default_contact"
            android:textSize="13sp" />

        <!-- 这个按钮才是奶奶真正会点的东西：把这个人放到桌面上。 -->
        <Button
            android:id="@+id/button_row_shortcut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_create_shortcut"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_row_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_save"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_row_delete"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_delete"
            android:textColor="@color/accent_voice"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
