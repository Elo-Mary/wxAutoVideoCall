<?xml version="1.0" encoding="utf-8"?>
<!--
  一键拨号卡片。
  设计约束（针对不太会用智能手机的老人）：
  * 不占满全屏，四周留白明显，点外面能直接关掉；
  * 按钮最少、最大；
  * 不放任何「高级」选项，设置入口做成一个不起眼的小字，避免误触。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hint_choose_contact"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/accent_voice"
            android:textSize="17sp"
            android:visibility="gone"
            tools:ignore="MissingDefaultResource" />

        <LinearLayout
            android:id="@+id/container_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/text_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/msg_need_one_contact"
            android:textColor="@color/accent_voice"
            android:textSize="19sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/button_settings_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/msg_tap_to_settings"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
