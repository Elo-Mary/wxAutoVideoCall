<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 及以上的备份规则：只备份设置，不备份日志。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="debug_log.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="debug_log.xml" />
    </device-transfer>
</data-extraction-rules>
