<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 需要判断微信是否安装，否则要给出「请先装微信」的提示。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 无障碍被系统关掉时震动提醒使用者。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 拨号流程中保持屏幕清醒，避免走到一半熄屏导致点击失效。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      「显示在其他应用上层」。不是本应用的必需品，但在部分 ROM 上，
      持有它才能让「无障碍服务去启动微信」走通（Android 10+ 的后台启动限制）。
      在权限引导页里作为可选的加固项引导用户开启。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WxAutoVideoCall"
        tools:targetApi="36">

        <!--
          桌面图标 / 联系人快捷方式的落点。
          刻意不设 launchMode 与 noHistory：
          每个联系人的快捷方式都要用自己的 Intent extra 打开自己的实例，
          singleTask 会让后来的快捷方式复用到前一个实例上，显示成上一个人的名字。
          拨号后由代码 finish() 收尾。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.WxAutoVideoCall.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页：联系人、拨号方式、日志开关。 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <!-- 权限引导页：无障碍、自启动、电池白名单。 -->
        <activity
            android:name=".ui.PermissionGuideActivity"
            android:exported="false"
            android:label="@string/title_permission_guide" />

        <!-- 日志页：出问题时把现场复制出来。 -->
        <activity
            android:name=".ui.LogActivity"
            android:exported="false"
            android:label="@string/label_view_log" />

        <service
            android:name=".service.CallAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
