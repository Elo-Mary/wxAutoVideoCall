# 构建产物
build/
app/build/
.gradle/
captures/
*.apk
*.aab
*.ap_
*.apk.idsig
*.dex
*.class

# 不写 `*.jar`：gradle/wrapper/gradle-wrapper.jar 是构建入口，必须入库。
# 用 `!gradle/wrapper/gradle-wrapper.jar` 开例外是无效的 ——
# 父目录被排除后无法重新包含其中的文件。要忽略自定义 jar 就在这里逐条列。
libs/*.jar

# 原生构建（NDK）
.externalNativeBuild/
.cxx/

# 签名与密钥
*.keystore
*.jks
*.p12
keystore.properties

# 本机专属配置：local.properties 存的是各自的 SDK 路径。
# gradle.properties 不在此列，它存的是全工程通用配置，必须入库。
local.properties

# 仅本地保留，不入库
需求.txt
AGENTS.md

# IDE 与编辑器
.idea/
*.iml
.vscode/
out/
*.hprof
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 其他
*.log
__pycache__/
*.pyc
