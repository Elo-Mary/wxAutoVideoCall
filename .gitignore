# ============================================================================
# .gitignore
#
# 原则：**只忽略生成物和本机专属配置，其他一律入库。**
#
# 两条容易踩的坑，改这个文件前先看：
#   1) gradle/wrapper/gradle-wrapper.jar 必须入库（别人 clone 下来靠它跑
#      ./gradlew）。所以这里**不能**写 `*.jar`，也不能靠 `!` 例外来救 ——
#      详见下面 31 行处的说明。
#   2) 需求.txt 是需求原件，必须入库，不要顺手忽略掉。
# ============================================================================

# ---------------------------------------------------------------- 构建产物
# Gradle / Android 的编译输出。全部可由源码重建，不入库。
build/
app/build/
.gradle/
captures/
# AGP 的问题报告，每次构建都会重新生成。
build/reports/
# 单元测试与仪器测试的报告（本工程暂无测试，先占位）。
*/build/reports/
*/build/test-results/

# 编译中间物。正常都在 build/ 里，这里再兜一层，
# 防止有人手动执行 aapt2/javac/d8 时把产物落在仓库根目录。
*.apk
*.aab
*.ap_
*.dex
*.class
# apksigner 生成的 v4 签名旁文件，和 apk 一起出现。
*.apk.idsig

# 注意：这里**故意不写 `.jar`**。
# gradle/wrapper/gradle-wrapper.jar 是二进制的构建入口，必须入库；
# 而 `!gradle/wrapper/gradle-wrapper.jar` 这种例外**不会生效**，
# 因为 Git 的规则是「父目录被排除后，无法重新包含其中的文件」。
# 所以下面逐条列出真正要忽略的 jar，而不是用通配符再开例外。
# 将来引入自定义 jar 时，在这里补一条，或者在 build/ 下放置（那已被整体忽略）。
libs/*.jar
*.hprof

# 原生构建（NDK）。本工程目前没有 native 代码，留作将来使用。
.externalNativeBuild/
.cxx/

# ---------------------------------------------------------------- 测试报告与覆盖率
reports/
test-results/

# ---------------------------------------------------------------- 签名与密钥
# 签名密钥一旦入库就等于泄露，永远不要提交。
# 发布版密钥由维护者单独保管，不放在仓库里。
*.keystore
*.jks
*.p12
keystore.properties
# 有的做法是把签名信息写在 local.properties 里，那一份下面也会被忽略。

# ---------------------------------------------------------------- 本机专属配置
# local.properties 里是每台机器的 Android SDK / NDK 路径，不通用。
# 新克隆仓库的人需要自己创建，或由 Android Studio 自动生成。
# 注意：这里**不要**忽略 gradle.properties —— 它存的是全工程通用的
# JVM 内存、UTF-8 编码、AndroidX 开关等配置，必须入库。
local.properties

# ---------------------------------------------------------------- IDE 与编辑器
# Android Studio / IntelliJ
.idea/
*.iml
# 有些 IDE 把工程文件放在模块目录下，兜一层。
out/
# VS Code
.vscode/
# 编辑器临时文件
*.swp
*.swo
*~

# ---------------------------------------------------------------- 操作系统
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------- 日志与其他
# 随手导出的日志（例如从应用的日志页复制出来的内容）。
*.log
# Python 残留，仅在用脚本处理文件时会产生。
__pycache__/
*.pyc
